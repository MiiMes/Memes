{
  "name": "Memes — GIFs and meme editor",
  "short_name": "Memes",
  "description": "Find GIFs and create memes in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/gif": [".gif"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "video/mp4": [".mp4"],
        "video/webm": [".webm"],
        "video/ogg": [".ogv", ".ogg"],
        "video/quicktime": [".mov"],
        "application/vnd.memes.project+json": [".meme"]
      }
    }
  ],
  "background_color": "#111111",
  "theme_color": "#111111",
  "icons": [
    {
      "src": "./memes-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
